# Claude API (required) — used to generate dashboard concepts, DAX measures, and build instructions
ANTHROPIC_API_KEY=

# Power BI publishing (optional — only needed for the "Publish to Power BI" step)
# Create an Azure AD app registration with Power BI Service API permissions
# (Dataset.ReadWrite.All, Report.ReadWrite.All, Workspace.ReadWrite.All) and
# admin consent, then fill these in. See README.md for the full walkthrough.
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
