<Window
    x:Class="GeoCompassSort.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left column: inputs -->
        <StackPanel Grid.Column="0" Spacing="16">
            <TextBlock Text="Geotagged Photo Compass Sort" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock
                Text="Enter the asset's centre point, then choose the folder of geotagged photos to sort into North / North-East / East / South-East / South / South-West / West / North-West folders based on where each photo was taken relative to the asset."
                TextWrapping="Wrap" Opacity="0.8" />

            <TextBlock Text="Asset centre point" Style="{StaticResource SubtitleTextBlockStyle}" />
            <NumberBox
                x:Name="LatitudeBox"
                Header="Latitude (decimal degrees, e.g. 53.4808)"
                PlaceholderText="e.g. 53.4808"
                SpinButtonPlacementMode="Inline"
                SmallChange="0.0001" LargeChange="1" />
            <NumberBox
                x:Name="LongitudeBox"
                Header="Longitude (decimal degrees, e.g. -2.2426)"
                PlaceholderText="e.g. -2.2426"
                SpinButtonPlacementMode="Inline"
                SmallChange="0.0001" LargeChange="1" />

            <TextBlock Text="Photos" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="SourceFolderBox" Header="Source folder" Width="280" IsReadOnly="True" />
                <Button Content="Browse…" Click="OnBrowseSourceFolder" VerticalAlignment="Bottom" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="OutputFolderBox" Header="Output folder" Width="280" IsReadOnly="True" />
                <Button Content="Browse…" Click="OnBrowseOutputFolder" VerticalAlignment="Bottom" />
            </StackPanel>

            <CheckBox x:Name="IncludeSubfoldersBox" Content="Include photos in subfolders" />

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <Button x:Name="SortButton" Content="Sort Photos" Style="{StaticResource AccentButtonStyle}" Click="OnSortClicked" />
                <ProgressRing x:Name="Spinner" IsActive="False" Width="24" Height="24" />
            </StackPanel>

            <InfoBar
                x:Name="StatusBar"
                IsOpen="False"
                Margin="0,8,0,0" />
        </StackPanel>

        <!-- Right column: results -->
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="SummaryText" Grid.Row="0" Text="No photos sorted yet." Style="{StaticResource BodyStrongTextBlockStyle}" />

            <ListView x:Name="ResultsList" Grid.Row="1">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="4,0" ColumnDefinitions="2*,*,*,*">
                            <TextBlock Grid.Column="0" Text="File" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Status" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Sector" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Bearing" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,2" ColumnDefinitions="2*,*,*,*">
                            <TextBlock Grid.Column="0" Text="{Binding FileName}" ToolTipService.ToolTip="{Binding SourcePath}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" />
                            <TextBlock Grid.Column="2" Text="{Binding SectorText}" />
                            <TextBlock Grid.Column="3" Text="{Binding BearingText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
