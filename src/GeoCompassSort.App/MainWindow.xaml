<Window
    x:Class="GeoCompassSort.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Padding="24" RowSpacing="16">
        <Grid.Resources>
            <Style x:Key="SectorCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="MinHeight" Value="96" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + asset centre point -->
        <Grid Grid.Row="0" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="🧭 Geotagged Photo Compass Sort" FontSize="26" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Asset centre" VerticalAlignment="Center" Opacity="0.7" />
                    <NumberBox
                        x:Name="LatitudeBox"
                        PlaceholderText="Latitude"
                        Width="150"
                        SpinButtonPlacementMode="Compact"
                        SmallChange="0.0001" LargeChange="1" />
                    <NumberBox
                        x:Name="LongitudeBox"
                        PlaceholderText="Longitude"
                        Width="150"
                        SpinButtonPlacementMode="Compact"
                        SmallChange="0.0001" LargeChange="1" />
                    <Button Content="Paste “lat, long”" Click="OnPasteCoordinates" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock
                    x:Name="OutputFolderText"
                    Text="Output folder: chosen automatically on first drop"
                    Opacity="0.7"
                    TextTrimming="CharacterEllipsis"
                    TextAlignment="Right"
                    MaxWidth="320" />
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                    <HyperlinkButton Content="Change output folder" Click="OnChangeOutputFolder" Padding="0" />
                    <HyperlinkButton Content="Start new asset" Click="OnResetSession" Padding="0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" />

        <!-- Main content: drop zone + results -->
        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Drop zone -->
            <Border
                Grid.Column="0"
                x:Name="DropZoneBorder"
                AllowDrop="True"
                DragOver="OnDragOver"
                DragLeave="OnDragLeave"
                Drop="OnDrop"
                Tapped="OnDropZoneTapped"
                CornerRadius="20"
                BorderThickness="2"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DropZoneScale" ScaleX="1" ScaleY="1" CenterX="150" CenterY="150" />
                </Border.RenderTransform>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Padding="28">
                    <TextBlock Text="📥" FontSize="52" HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Drag photos or a folder here"
                        FontSize="19" FontWeight="SemiBold"
                        HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock
                        Text="or click to browse for photos"
                        Opacity="0.7" HorizontalAlignment="Center" />
                    <ProgressRing x:Name="Spinner" IsActive="False" Width="30" Height="30" HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="DropStatusText"
                        HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                        Opacity="0.85" MaxWidth="240" />
                </StackPanel>
            </Border>

            <!-- Results -->
            <Grid Grid.Column="1" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    x:Name="SummaryText"
                    Text="Drop some geotagged photos to get started."
                    FontSize="16" Opacity="0.85" />

                <!-- Compass grid: NW N NE / W [total] E / SW S SE -->
                <Grid Grid.Row="1" ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" x:Name="CellNorthWest" Style="{StaticResource SectorCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="↖" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="North-West" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CountNorthWest" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" x:Name="CellNorth" Style="{StaticResource SectorCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="↑" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="North" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CountNorth" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" x:Name="CellNorthEast" Style="{StaticResource SectorCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="↗" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="North-East" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CountNorthEast" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" x:Name="CellWest" Style="{StaticResource SectorCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="←" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="West" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CountWest" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="16" Background="{ThemeResource AccentFillColorDefaultBrush}" Padding="12" MinHeight="96">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="🧭" FontSize="26" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TotalSortedText" Text="0" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                            <TextBlock Text="sorted" FontSize="12" HorizontalAlignment="Center" Foreground="White" Opacity="0.9" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" x:Name="CellEast" Style="{StaticResource SectorCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="→" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="East" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CountEast" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" x:Name="CellSouthWest" Style="{StaticResource SectorCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="↙" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="South-West" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CountSouthWest" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" x:Name="CellSouth" Style="{StaticResource SectorCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="↓" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="South" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CountSouth" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" x:Name="CellSouthEast" Style="{StaticResource SectorCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="↘" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="South-East" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CountSouthEast" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Button
                    Grid.Row="2"
                    x:Name="OpenOutputButton"
                    Content="📂 Open output folder"
                    Click="OnOpenOutputFolder"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed" />

                <Expander
                    Grid.Row="3"
                    x:Name="IssuesExpander"
                    Header="0 skipped"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False"
                    Visibility="Collapsed">
                    <ListView x:Name="IssuesList" MaxHeight="240">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚠️" />
                                    <TextBlock Text="{Binding FileName}" ToolTipService.ToolTip="{Binding SourcePath}" />
                                    <TextBlock Text="{Binding StatusText}" Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</Window>
